{
  "manifest_version": 3,
  "name": "TubeFolio2",
  "version": "0.1.0",
  "description": "YouTube登録チャンネルをグループ(複数所属可)で整理。登録フィードの絞り込み、視聴済み非表示、グループ一括再生に対応。",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "TubeFolio2 グループ管理を開く" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["store.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
