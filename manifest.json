{
  "manifest_version": 3,
  "name": "TubeFolio2",
  "version": "0.1.0",
  "description": "YouTube登録チャンネルをグループ(複数所属可)で整理。登録フィードの絞り込み、視聴済み非表示、グループ一括再生に対応。",
  "permissions": ["storage", "unlimitedStorage", "cookies", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "identity", "alarms", "contextMenus", "notifications"],
  "key": "",
  "web_accessible_resources": [{ "resources": ["manager.html", "manager.css", "manager.js", "store.js", "theme.js", "page.html", "page.css", "page.js", "pv.html", "pv.js"], "matches": ["https://www.youtube.com/*"] }, { "resources": ["sounds/*.mp3"], "matches": ["https://www.youtube.com/*"] }],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://translate.googleapis.com/*", "https://sponsor.ajay.app/*", "https://ja.wikipedia.org/*", "https://en.wikipedia.org/*", "https://returnyoutubedislikeapi.com/*", "https://api.github.com/*", "https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*", "https://ipapi.co/*", "https://archive.org/*", "https://web.archive.org/*", "https://www.youtube-nocookie.com/*", "https://trends.google.co.jp/*", "https://news.google.com/*", "https://www.bing.com/*", "https://i.ytimg.com/*", "https://youtube-trending.info/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "TubeFolio2 を更新(拡張機能・YouTube・管理画面を読み込み直す)", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["early.js"], "run_at": "document_start" },
    { "matches": ["https://www.youtube.com/*"], "js": ["nav-main.js", "mainworld.js", "perf-main.js"], "run_at": "document_start", "world": "MAIN" },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["ui-sync.js", "store.js", "focus.js", "tf-shim.js", "yt-api.js", "setspec.js", "content.js", "comments.js", "extras.js", "chapters.js", "playerx.js", "perf.js", "xtra.js", "antitrans.js", "speaker.js", "memhide.js", "toolpanel.js", "toolbtn.js", "later-glue.js", "watchadd.js", "histrec.js", "bookmark-key.js", "playedtags.js", "tagmgr.js", "hover-tune.js", "preview-host.js", "trends.js", "bgwait.js"],
      "css": ["content.css", "comments.css", "tools.css", "watchq.css", "bmkey.css", "trends.css"],
      "run_at": "document_idle"
    }
  ]
}
